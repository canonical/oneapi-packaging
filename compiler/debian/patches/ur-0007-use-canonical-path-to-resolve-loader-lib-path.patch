From c3f2aca0400088e6b96e1e5b2219d1d4bec6d09f Mon Sep 17 00:00:00 2001
From: Piotr Balcer <piotr.balcer@intel.com>
Date: Fri, 20 Mar 2026 10:32:29 +0000
Subject: [PATCH] [UR] use canonical path to resolve loader lib path

---
 unified-runtime/source/loader/linux/adapter_search.cpp | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/unified-runtime/source/loader/linux/adapter_search.cpp b/unified-runtime/source/loader/linux/adapter_search.cpp
index ea6b363ee4ff9..38427e0d799bd 100644
--- a/unified-runtime/source/loader/linux/adapter_search.cpp
+++ b/unified-runtime/source/loader/linux/adapter_search.cpp
@@ -24,7 +24,7 @@ std::optional<fs::path> getLoaderLibPath() {
   if (dladdr((void *)getLoaderLibPath, &info)) {
     auto libPath = fs::path(info.dli_fname);
     if (fs::exists(libPath)) {
-      return fs::absolute(libPath).parent_path();
+      return fs::canonical(libPath).parent_path();
     }
   }
 
