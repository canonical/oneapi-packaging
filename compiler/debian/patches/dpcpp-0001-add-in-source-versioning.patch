From 1a1628989665019d8cdb9a720f062aef57d4a880 Mon Sep 17 00:00:00 2001
From: Elizabeth Andrews <elizabeth.andrews@intel.com>
Date: Mon, 23 Mar 2026 08:30:42 -0700
Subject: [PATCH] [SYCL] Add in-source versioning for DPCPP compiler

---
 clang/CMakeLists.txt                     |  2 ++
 clang/include/clang/Basic/Version.h      |  3 +++
 clang/include/clang/Basic/Version.inc.in |  5 +++++
 clang/lib/Basic/Version.cpp              | 16 ++++++++++++++++
 clang/lib/Driver/Driver.cpp              |  1 +
 clang/test/Driver/dpcpp_version.cpp      |  3 +++
 cmake/Modules/DPCPPVersion.cmake         | 13 +++++++++++++
 llvm/CMakeLists.txt                      |  1 +
 8 files changed, 44 insertions(+)
 create mode 100644 clang/test/Driver/dpcpp_version.cpp
 create mode 100644 cmake/Modules/DPCPPVersion.cmake

diff --git a/clang/CMakeLists.txt b/clang/CMakeLists.txt
index c2590e27dbf1..934713c8c546 100644
--- a/clang/CMakeLists.txt
+++ b/clang/CMakeLists.txt
@@ -336,6 +336,8 @@ set(CLANG_VERSION "${CLANG_VERSION_MAJOR}.${CLANG_VERSION_MINOR}.${CLANG_VERSION
 set(MAX_CLANG_ABI_COMPAT_VERSION "${LLVM_VERSION_MAJOR}")
 message(STATUS "Clang version: ${CLANG_VERSION}")
 
+set(DPCPP_VERSION "${DPCPP_VERSION_MAJOR}.${DPCPP_VERSION_MINOR}.${DPCPP_VERSION_PATCH}")
+
 # Configure the Version.inc file.
 configure_file(
   ${CMAKE_CURRENT_SOURCE_DIR}/include/clang/Basic/Version.inc.in
diff --git a/clang/include/clang/Basic/Version.h b/clang/include/clang/Basic/Version.h
index eb2c56f33c66..ad00bcaec902 100644
--- a/clang/include/clang/Basic/Version.h
+++ b/clang/include/clang/Basic/Version.h
@@ -66,6 +66,9 @@ namespace clang {
   /// the CL_SYCL_LANGUAGE_VERSION and SYCL_LANGUAGE_VERSION macros.
   llvm::SmallVector<std::pair<llvm::StringRef, llvm::StringRef>, 2>
   getSYCLVersionMacros(const LangOptions &LangOpts);
+
+  /// Retrieves a string representing the DPC++ Version.
+  std::string getDPCPPVersion();
 }
 
 #endif // LLVM_CLANG_BASIC_VERSION_H
diff --git a/clang/include/clang/Basic/Version.inc.in b/clang/include/clang/Basic/Version.inc.in
index 69c79d03861c..e2d9c8936a80 100644
--- a/clang/include/clang/Basic/Version.inc.in
+++ b/clang/include/clang/Basic/Version.inc.in
@@ -5,3 +5,8 @@
 #define CLANG_VERSION_MINOR @CLANG_VERSION_MINOR@
 #define CLANG_VERSION_PATCHLEVEL @CLANG_VERSION_PATCHLEVEL@
 #define MAX_CLANG_ABI_COMPAT_VERSION @MAX_CLANG_ABI_COMPAT_VERSION@
+#define DPCPP_VERSION_MAJOR @DPCPP_VERSION_MAJOR@
+#define DPCPP_VERSION_MINOR @DPCPP_VERSION_MINOR@
+#define DPCPP_VERSION_PATCH @DPCPP_VERSION_PATCH@
+#define DPCPP_VERSION "@DPCPP_VERSION@"
+#define PRE_RELEASE @PRE_RELEASE@
diff --git a/clang/lib/Basic/Version.cpp b/clang/lib/Basic/Version.cpp
index 84be9bb1d992..80e69980a0db 100644
--- a/clang/lib/Basic/Version.cpp
+++ b/clang/lib/Basic/Version.cpp
@@ -65,6 +65,22 @@ std::string getClangVendor() {
 #endif
 }
 
+
+std::string getDPCPPPreReleaseInfo() {
+#if PRE_RELEASE
+  std::string buf;
+  llvm::raw_string_ostream OS(buf);
+  OS << DPCPP_VERSION << " (pre-release)";
+  return buf;
+#else
+  return DPCPP_VERSION;
+#endif
+}
+
+std::string getDPCPPVersion() {
+  return getDPCPPPreReleaseInfo();
+}
+
 std::string getClangFullRepositoryVersion() {
   std::string buf;
   llvm::raw_string_ostream OS(buf);
diff --git a/clang/lib/Driver/Driver.cpp b/clang/lib/Driver/Driver.cpp
index 214f84f83520..608907f215eb 100644
--- a/clang/lib/Driver/Driver.cpp
+++ b/clang/lib/Driver/Driver.cpp
@@ -2834,6 +2834,7 @@ void Driver::PrintSYCLToolHelp(const Compilation &C) const {
 }
 
 void Driver::PrintVersion(const Compilation &C, raw_ostream &OS) const {
+  OS << "DPC++ compiler " << getDPCPPVersion() << " build based on:\n";
   if (IsFlangMode()) {
     OS << getClangToolFullVersion("flang") << '\n';
   } else {
diff --git a/clang/test/Driver/dpcpp_version.cpp b/clang/test/Driver/dpcpp_version.cpp
new file mode 100644
index 000000000000..d1745e657f40
--- /dev/null
+++ b/clang/test/Driver/dpcpp_version.cpp
@@ -0,0 +1,3 @@
+// RUN: %clang --version 2>&1 | FileCheck %s
+
+// CHECK: DPC++ compiler {{.*}}based on:
diff --git a/cmake/Modules/DPCPPVersion.cmake b/cmake/Modules/DPCPPVersion.cmake
new file mode 100644
index 000000000000..4e295d553545
--- /dev/null
+++ b/cmake/Modules/DPCPPVersion.cmake
@@ -0,0 +1,13 @@
+# DPCPP Version number information
+
+if(NOT DEFINED DPCPP_VERSION_MAJOR)
+  set(DPCPP_VERSION_MAJOR 6)
+endif()
+if(NOT DEFINED DPCPP_VERSION_MINOR)
+  set(DPCPP_VERSION_MINOR 2)
+endif()
+if(NOT DEFINED DPCPP_VERSION_PATCH)
+  set(DPCPP_VERSION_PATCH 0)
+endif()
+set(PRE_RELEASE 0)
+
diff --git a/llvm/CMakeLists.txt b/llvm/CMakeLists.txt
index 44e4b76d9f92..ee36f0a4991d 100644
--- a/llvm/CMakeLists.txt
+++ b/llvm/CMakeLists.txt
@@ -18,6 +18,7 @@ if(NOT LLVM_NO_INSTALL_NAME_DIR_FOR_BUILD_TREE)
 endif()
 
 include(${LLVM_COMMON_CMAKE_UTILS}/Modules/LLVMVersion.cmake)
+include(${LLVM_COMMON_CMAKE_UTILS}/Modules/DPCPPVersion.cmake)
 
 set_directory_properties(PROPERTIES LLVM_VERSION_MAJOR "${LLVM_VERSION_MAJOR}")
 
-- 
2.39.1

